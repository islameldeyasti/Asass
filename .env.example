# ASAS local secrets (do not commit)

# --- Admin CMS ---
# First Super Admin is auto-created on first login/API hit if no users exist.
ADMIN_EMAIL=admin@asasengg.ae
ADMIN_PASSWORD=asas-admin
# Optional signing secret for session cookies (defaults to ADMIN_PASSWORD)
# ADMIN_SECRET=

# --- Gemini (production AI Assistant: text + Live Voice) ---
# Add this in Frontend/.env.local (never commit the real key).
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Cost / session controls (server-side)
VOICE_ENABLED=true
MAX_VOICE_SESSION_MINUTES=5
MAX_TEXT_MESSAGES_PER_SESSION=30
MAX_MESSAGE_LENGTH=3000

# --- Delivery / mail / backups ---
# Live email (optional). Without this, messages are queued in Frontend/.data/mail/queue.jsonl
# RESEND_API_KEY=
# MAIL_FROM=ASAS Engineering <noreply@asasengg.ae>
STAFF_NOTIFY_EMAIL=admin@asasengg.ae
# Optional ERP sqlite path (default Frontend/.data/erp/company.sqlite)
# ASAS_ERP_DB=
